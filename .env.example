# Copy to .env in the repository root.
# Docker bind mounts default to ./models and ./output, relative to compose.yaml.
# To keep data in the directories beside the old external Compose file,
# change these values. For example, if this fork lives in an old ./src folder:
# AUDIOCPP_MODELS_PATH=../models
# AUDIOCPP_OUTPUT_PATH=../output

# Optional local HTTP port (always bound to 127.0.0.1).
AUDIOCPP_PORT=8080

# Optional: set paths if your files are outside this repository.
# AUDIOCPP_MODELS_PATH=./models
# AUDIOCPP_OUTPUT_PATH=./output

# Required only for: docker compose --profile remote up -d --build
# Store your Cloudflare Tunnel token here. Never commit .env.
CLOUDFLARE_TUNNEL_TOKEN=
